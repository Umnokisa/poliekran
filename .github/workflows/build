name: Build

on:
  push:
    branches: [main, master]
    tags: ['v*']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest
    outputs:
      version: ${{ steps.ver.outputs.version }}
    steps:
      - uses: actions/checkout@v5
        with:
          persist-credentials: false

      - uses: actions/setup-dotnet@v5
        with:
          dotnet-version: '8.0.x'

      - name: Version
        id: ver
        shell: pwsh
        run: |
          if ($env:GITHUB_REF -like 'refs/tags/v*') {
            $v = $env:GITHUB_REF_NAME.Substring(1)
          } else {
            $v = "$(([xml](Get-Content src/Poliekran.csproj)).Project.PropertyGroup.Version | Where-Object { $_ } | Select-Object -First 1)"
          }
          if ($v -notmatch '^\d+\.\d+\.\d+$') { throw "Version must look like 1.2.3, got '$v'" }
          "version=$v" >> $env:GITHUB_OUTPUT

      - name: Build DLL
        run: dotnet build src -c Release -o out -p:Version=${{ steps.ver.outputs.version }}

      - name: Install NSIS
        shell: pwsh
        run: |
          if (-not (Get-Command makensis -ErrorAction SilentlyContinue) -and -not (Test-Path "${env:ProgramFiles(x86)}\NSIS\makensis.exe")) {
            choco install nsis -y --no-progress
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          }

      - name: Build installer
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force dist | Out-Null
          $m = (Get-Command makensis -ErrorAction SilentlyContinue).Source
          if (-not $m) { $m = "${env:ProgramFiles(x86)}\NSIS\makensis.exe" }
          & $m /V2 "/DVER=${{ steps.ver.outputs.version }}" installer\setup.nsi
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

      - name: Package source code
        shell: pwsh
        run: |
          $stage = Join-Path $env:GITHUB_WORKSPACE "dist\source\for funcode"
          New-Item -ItemType Directory -Force $stage | Out-Null
          $items = @('src', 'installer', 'assets', 'docs', '.github', 'README.md', 'LICENSE', 'build.cmd')
          foreach ($item in $items) {
            $source = Join-Path $env:GITHUB_WORKSPACE $item
            $target = Join-Path $stage $item
            $parent = Split-Path $target -Parent
            New-Item -ItemType Directory -Force $parent | Out-Null
            Copy-Item -LiteralPath $source -Destination $target -Recurse -Force
          }

      - name: Upload installer artifact
        uses: actions/upload-artifact@v5
        with:
          name: Poliekran-${{ steps.ver.outputs.version }}-installer
          path: dist/*.exe

      - name: Upload source artifact
        uses: actions/upload-artifact@v5
        with:
          name: Poliekran-${{ steps.ver.outputs.version }}-source
          path: dist/source

  release:
    needs: build
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v5
        with:
          name: Poliekran-${{ needs.build.outputs.version }}-installer
          path: art

      - uses: softprops/action-gh-release@v2
        with:
          files: art/*.exe
          generate_release_notes: true
